# Keep this empty when React and the PHP api folder are uploaded to the same domain.
# For a separate API domain, use for example:
# VITE_API_URL=https://your-domain.example/api
VITE_API_URL=

# Create a Web OAuth client in Google Cloud Console and add your local and
# production URLs under Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
